flowchart LR
  subgraph App["ForgeWire application"]
    Operator["Operator authority"] --> Intent["Bounded work intent<br/>scope · capability · policy"]
    Intent --> Adapter["Selected workflow adapter<br/>configuration-dependent"]
    Adapter --> Dispatch["Authorized dispatch request"]
  end

  subgraph Fabric["ForgeWire Fabric · private alpha implementation"]
    Hub["Fabric control plane<br/>policy · approvals · routing"]
    Verify["Runner checks dispatcher<br/>and requested authority"]
    Execute["Run within approved scope"]
    Outcome["Status · result · failure evidence"]
    Hub --> Verify
    Verify -->|permitted| Execute
    Verify -->|denied / unavailable| Outcome
    Execute --> Outcome
  end

  Dispatch -. "remote dispatch" .-> Hub
  Outcome --> Review["Return outcome to<br/>authorized caller for review"]
  Review --> FollowUp["Caller or operator decides<br/>next action"]

  subgraph Legend["Diagram key"]
    direction LR
    L1["Existing"] --- L2["Optional / configuration-dependent"] --- L3["Private implementation"] --- L4["Proposed / uncomposed"]
  end

  classDef existing fill:#eaf4ff,stroke:#4c8cb5,color:#12324a,stroke-width:1.5px;
  classDef optional fill:#f2edff,stroke:#8063bf,color:#38255b,stroke-width:1.5px;
  classDef private fill:#e4f4f0,stroke:#3c9182,color:#123f39,stroke-width:1.5px;
  classDef proposed fill:#fff4d9,stroke:#d49a31,color:#543b0b,stroke-dasharray:5 4;
  class Operator,Intent,Dispatch,Review,FollowUp existing;
  class Adapter optional;
  class Hub,Verify,Execute,Outcome private;
  class App existing;
