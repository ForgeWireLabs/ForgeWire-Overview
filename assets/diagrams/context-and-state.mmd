  Task["Task workflows"] --> TStore["Task repository"]
  Job["Background work"] --> JStore["Job repository"]
  Conversation --> Bus["Async message bus<br/>in-process messages"]
  Task --> Bus
  Job --> Bus
  Conversation -. "separate local notification path" .-> Local["Synchronous local notifications"]
